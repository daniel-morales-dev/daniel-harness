{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daniel-harness.local/schemas/project-registry.schema.json",
  "title": "Daniel Harness Project Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "families", "relationships"],
  "properties": {
    "version": { "const": "1" },
    "families": {
      "type": "array",
      "items": { "$ref": "#/$defs/family" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    }
  },
  "$defs": {
    "context": {
      "enum": ["alegra-monolith", "alegra-microservice", "freelance"]
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contexts", "projects"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/context" }
        },
        "projects": {
          "type": "array",
          "items": { "$ref": "#/$defs/project" }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "context", "rules", "git"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "path": { "type": "string", "minLength": 1 },
        "context": { "$ref": "#/$defs/context" },
        "rules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": ["askBeforeBranch", "commit", "push", "deploy"],
          "properties": {
            "askBeforeBranch": { "const": true },
            "commit": { "enum": ["ask", "allowed"] },
            "push": { "enum": ["ask", "allowed"] },
            "deploy": { "enum": ["ask", "deny", "project-policy"] }
          }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "defaultAccess"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "type": { "enum": ["migration", "shared-domain", "infrastructure", "documentation"] },
        "defaultAccess": { "enum": ["read", "read-write"] }
      }
    }
  }
}
