{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daniel-harness.local/schemas/config.schema.json",
  "title": "Daniel Harness Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaultScope", "workflowAuthority", "tooling", "workTracking", "models", "mcpRouting", "confirmations"],
  "properties": {
    "version": {
      "const": "1"
    },
    "defaultScope": {
      "$ref": "#/$defs/taskScope"
    },
    "workflowAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "implementationRouting", "sddActivation", "review", "capabilityNegotiation"],
      "properties": {
        "provider": { "const": "gentle-ai" },
        "implementationRouting": { "const": "provider-policy" },
        "sddActivation": { "const": "explicit-or-accepted-proposal" },
        "review": { "const": "receipt-driven-development" },
        "capabilityNegotiation": { "const": true }
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codeExploration", "memory", "codeSimplicity", "communication", "communicationMode"],
      "properties": {
        "codeExploration": { "const": "codegraph" },
        "memory": { "const": "engram" },
        "codeSimplicity": { "const": "ponytail" },
        "communication": { "const": "caveman" },
        "communicationMode": { "enum": ["adaptive", "lite", "full", "ultra"] }
      }
    },
    "workTracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "whenIssueLinked", "readHierarchy", "readRelated", "progressComments", "commentLanguage", "closeWhenVerified"],
      "properties": {
        "provider": { "const": "linear" },
        "whenIssueLinked": { "const": true },
        "readHierarchy": { "const": true },
        "readRelated": { "const": true },
        "progressComments": { "const": "meaningful-transitions" },
        "commentLanguage": { "const": "es" },
        "closeWhenVerified": { "const": true }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/modelPolicy" }
    },
    "mcpRouting": {
      "type": "array",
      "items": { "$ref": "#/$defs/mcpRoute" }
    },
    "confirmations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branchCreation", "productionMutation", "dynamodbWrite", "mongodbWrite"],
      "properties": {
        "branchCreation": { "const": "always" },
        "productionMutation": { "const": "always" },
        "dynamodbWrite": { "const": "exact-operation" },
        "mongodbWrite": { "enum": ["always", "deny"] }
      }
    }
  },
  "$defs": {
    "taskScope": {
      "enum": ["single-repo", "related-repos", "multi-project"]
    },
    "modelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trust", "allowArbitraryShell", "allowedCapabilities"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "trust": { "enum": ["trusted", "restricted"] },
        "allowArbitraryShell": { "type": "boolean" },
        "allowedCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "trust": { "const": "restricted" } },
            "required": ["trust"]
          },
          "then": {
            "properties": { "allowArbitraryShell": { "const": false } }
          }
        }
      ]
    },
    "mcpRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "server", "expectedState"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "server": { "type": "string", "minLength": 1 },
        "expectedState": { "enum": ["enabled", "disabled", "authentication-required", "discover"] }
      }
    }
  }
}
