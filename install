#!/usr/bin/env bash
# Entry point: instala y configura el harness desde cero
set -euo pipefail

ROOT_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
MANIFEST="$ROOT_DIR/bootstrap/manifest.yaml"

PROFILE=""
CONNECT=false
RESET_MANAGED=false
NON_INTERACTIVE=false
EXPERIMENTAL_DATA_TOOLS=false

# ── Parse args ──────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)   PROFILE=$2; shift 2 ;;
    --profile=*) PROFILE=${1#*=}; shift ;;
    --connect)   CONNECT=true; shift ;;
    --reset-managed) RESET_MANAGED=true; shift ;;
    --non-interactive) NON_INTERACTIVE=true; shift ;;
    --experimental-data-tools) EXPERIMENTAL_DATA_TOOLS=true; shift ;;
    --help|-h)
      cat <<'HELP'
Uso: ./install [opciones]

Opciones:
  --profile core|alegra|migration|full
      Perfil a instalar. Requerido en modo --non-interactive.
      Sin --profile en TTY muestra selector interactivo.

  --connect
      Autenticacion interactiva de MCPs, doctor y resumen final.

  --reset-managed
      Reinstala recursos administrados (symlinks, configs) y reconcilia MCPs.

  --non-interactive
      No mostrar prompts. Requiere --profile.

  --experimental-data-tools
      Instala closed data tools experimentales (beta).

  -h, --help
      Este mensaje.

Exit codes:
  0  Todo saludable
  1  Error técnico
  2  Instalado con OAuth pendiente
  3  Conflicto de recurso administrado
  4  Rollback o recovery incompleto
HELP
      exit 0 ;;
    *)
      printf 'Argumento desconocido: %s\n' "$1" >&2
      exit 1 ;;
  esac
done

# ── Connect + non-interactive check ──────────────────────────────
if [[ $CONNECT == true && $NON_INTERACTIVE == true ]]; then
  printf 'Error: --connect requiere modo interactivo.\n' >&2
  printf 'Usa --non-interactive sin --connect, o quita --non-interactive.\n' >&2
  exit 1
fi

# ── Profile selection ───────────────────────────────────────────
if [[ -z "$PROFILE" ]]; then
  if [[ -t 0 ]] && [[ $NON_INTERACTIVE == false ]]; then
    # ── interactive selector with resolved tools/MCPs via profile-resolver ──
    source "$ROOT_DIR/scripts/profile-resolver.sh"

    mapfile -t _profile_names < <(
      awk '
        /^profiles:/ { in_p=1; next }
        in_p && /^  [a-z][a-z0-9_-]+:$/ {
          n=$1; sub(/:$/,"",n); print n
        }
        in_p && /^[a-z]/ && !/^  / { in_p=0 }
      ' "$MANIFEST"
    )

    if [[ ${#_profile_names[@]} -eq 0 ]]; then
      printf 'Error: no se encontraron perfiles en %s\n' "$MANIFEST" >&2
      exit 1
    fi

    printf '\n  Perfiles disponibles:\n\n'
    for ((i=0; i<${#_profile_names[@]}; i++)); do
      _name="${_profile_names[$i]}"
      _desc=$(_get_profile_field "$_name" "description" 2>/dev/null | head -1 || echo "")
      _desc="${_desc:0:60}"
      _tools=$(get_profile_tools "$_name" 2>/dev/null | tr '\n' ',' | sed 's/,$//' || echo "")
      _mcps=$(get_profile_mcps "$_name" 2>/dev/null | tr '\n' ',' | sed 's/,$//' || echo "")
      printf '  %d) %-11s %s\n' $((i+1)) "$_name" "$_desc"
      [[ -n "$_tools" ]] && printf '     Herramientas: %s\n' "$_tools"
      [[ -n "$_mcps" ]] && printf '     MCPs: %s\n' "$_mcps"
    done

    printf '\n  Selecciona un perfil (1-%d): ' "${#_profile_names[@]}"
    read -r _sel
    _sel=$((_sel - 1))
    if [[ $_sel -lt 0 || $_sel -ge ${#_profile_names[@]} ]]; then
      printf '\n  Seleccion invalida\n' >&2
      exit 1
    fi
    printf '\n'
    PROFILE="${_profile_names[$_sel]}"
  else
    cat >&2 <<'ERR'
Error: --profile es requerido
  Usa: ./install --profile core|alegra|migration|full
  O ejecuta sin argumentos en una terminal para seleccion interactiva.
ERR
    exit 1
  fi
fi

# ── Validate profile ────────────────────────────────────────────
case "$PROFILE" in
  core|alegra|migration|full) ;;
  *)
    printf 'Error: perfil invalido: %s (core|alegra|migration|full)\n' "$PROFILE" >&2
    exit 1 ;;
esac

printf '==> Daniel Harness — perfil: %s\n' "$PROFILE"

# ── Preflight ───────────────────────────────────────────────────
if [[ ! -f /etc/os-release ]] || ! grep -qi 'ubuntu' /etc/os-release 2>/dev/null; then
  printf '  [aviso] Sistema no verificado como Ubuntu\n'
fi
if ! command -v sudo >/dev/null 2>&1; then
  printf 'error: sudo es necesario\n' >&2
  exit 1
fi

github_auth_state() {
  local config_root=${XDG_CONFIG_HOME:-"$HOME/.config"}
  local harness_dir=${DANIEL_HARNESS_CONFIG_DIR:-"$config_root/daniel-harness"}
  local secret_file="$harness_dir/secrets/github/authorization"
  local config_file="$config_root/opencode/opencode.json"
  local parent auth_ref

  if [[ -e "$secret_file" || -L "$secret_file" ]]; then
    parent=$(dirname "$secret_file")
    auth_ref=$(jq -r '.mcp.github.headers.Authorization // ""' "$config_file" 2>/dev/null || true)
    if [[ -f "$secret_file" && ! -L "$secret_file" &&
      "$(stat -c '%u' "$secret_file" 2>/dev/null || true)" == "$(id -u)" &&
      "$(stat -c '%a' "$secret_file" 2>/dev/null || true)" == "600" &&
      -d "$parent" && ! -L "$parent" &&
      "$(stat -c '%u' "$parent" 2>/dev/null || true)" == "$(id -u)" &&
      "$(stat -c '%a' "$parent" 2>/dev/null || true)" == "700" &&
      -s "$secret_file" && "$auth_ref" == "{file:$secret_file}" ]] &&
      head -n 1 "$secret_file" | grep -q '^Bearer '; then
      printf '%s\n' valid-persistent
    else
      printf '%s\n' invalid
    fi
  elif [[ -n "${GITHUB_PERSONAL_ACCESS_TOKEN:-}" ]]; then
    printf '%s\n' valid-env
  else
    printf '%s\n' missing
  fi
}

# ── Bootstrap ───────────────────────────────────────────────────
printf '\n==> Ejecutando bootstrap --profile %s...\n' "$PROFILE"
BOOTSTRAP_ARGS=(--profile "$PROFILE")
$CONNECT && BOOTSTRAP_ARGS+=(--connect)
$RESET_MANAGED && BOOTSTRAP_ARGS+=(--reset-managed)
$NON_INTERACTIVE && BOOTSTRAP_ARGS+=(--non-interactive)
$EXPERIMENTAL_DATA_TOOLS && BOOTSTRAP_ARGS+=(--experimental-data-tools)
set +e
bash "$ROOT_DIR/scripts/bootstrap.sh" "${BOOTSTRAP_ARGS[@]}"
bootstrap_rc=$?
set -e

case "$bootstrap_rc" in
  0)
    ;;
  2)
    printf '[aviso] Instalación aplicada; onboarding pendiente\n' >&2
    exit 2
    ;;
  3)
    printf '[error] Conflicto de recurso administrado\n' >&2
    exit 3
    ;;
  4)
    printf '[error] Recuperación incompleta; no se continuará\n' >&2
    exit 4
    ;;
  *)
    printf '[error] Bootstrap falló\n' >&2
    exit 1
    ;;
esac

# ── Connect ──────────────────────────────────────────────────────
AUTH_OK=0 AUTH_PENDING=0 AUTH_SKIP=0

if [[ $CONNECT == true ]]; then
  printf '\n==> Autenticacion interactiva...\n'

  MANIFEST="$ROOT_DIR/bootstrap/manifest.yaml"
  source "$ROOT_DIR/scripts/profile-resolver.sh"

  while IFS= read -r mcp_name; do
    [[ -z "$mcp_name" ]] && continue
    oauth_req=$(parse_mcp_field "$mcp_name" "oauth_required")

    if [[ "$oauth_req" != "true" ]]; then
      printf '  [- ] MCP %s: no requiere OAuth\n' "$mcp_name"
      AUTH_SKIP=$((AUTH_SKIP + 1))
      continue
    fi

    if ! command -v opencode >/dev/null 2>&1; then
      printf '  [aviso] opencode no instalado, salteando auth MCP %s\n' "$mcp_name"
      AUTH_PENDING=$((AUTH_PENDING + 1))
      continue
    fi

    printf '  [..] Autenticando MCP %s...\n' "$mcp_name"
    if opencode mcp auth "$mcp_name" >/dev/null 2>&1; then
      printf '  [ok] MCP %s autenticado\n' "$mcp_name"
      AUTH_OK=$((AUTH_OK + 1))
    else
      printf '  [aviso] MCP %s: autenticacion pendiente (ejecuta: opencode mcp auth %s)\n' "$mcp_name" "$mcp_name"
      AUTH_PENDING=$((AUTH_PENDING + 1))
    fi
  done < <(get_profile_mcps "$PROFILE")

  # Verificar GitHub PAT solo si github esta en los MCPs del perfil
  if profile_includes "$PROFILE" "mcps" "github"; then
    case "$(github_auth_state)" in
      valid-persistent) printf '  [ok] GitHub: autenticación persistente válida\n' ;;
      valid-env) printf '  [ok] GitHub: autenticación desde entorno disponible\n' ;;
      missing) printf '  [aviso] GitHub: autenticación no configurada (requerida para MCP GitHub)\n' ;;
      *) printf '  [aviso] GitHub: autenticación persistente inválida\n' ;;
    esac
  fi
fi

# ── Doctor (selección según modo) ─────────────────────────────────
printf '\n==> Verificando instalacion...\n'
DOCTOR_OK=false
AUTH_PENDING=${AUTH_PENDING:-0}
if [[ $CONNECT == true ]]; then
  bash "$ROOT_DIR/scripts/doctor.sh" --profile "$PROFILE" --strict && DOCTOR_OK=true || true
else
  bash "$ROOT_DIR/scripts/doctor.sh" --profile "$PROFILE" --strict --install-check --skip-oauth && DOCTOR_OK=true || true
fi

# ── Summary ───────────────────────────────────────────────────────
if [[ $DOCTOR_OK == true ]] && (( AUTH_PENDING == 0 )); then
  printf '\n========================================\n'
  printf '  Harness instalado y saludable\n'
  printf '  Perfil: %s\n' "$PROFILE"
  if [[ $CONNECT == true ]]; then
    printf '  MCPs: %d autenticados, %d pendientes, %d sin OAuth\n' "${AUTH_OK:-0}" "${AUTH_PENDING}" "${AUTH_SKIP:-0}"
  fi
  printf '========================================\n'
  exit 0
elif [[ $DOCTOR_OK == true ]] && (( AUTH_PENDING > 0 )); then
  printf '\n========================================\n'
  printf '  Harness instalado con OAuth pendiente\n'
  printf '  Perfil: %s\n' "$PROFILE"
  printf '  MCPs: %d autenticados, %d pendientes, %d sin OAuth\n' "${AUTH_OK:-0}" "${AUTH_PENDING}" "${AUTH_SKIP:-0}"
  printf '========================================\n'
  printf '\nAutentica los MCPs pendientes manualmente:\n'
  printf '  opencode mcp auth <nombre>\n'
  printf '\nRevisa: dh doctor\n'
  exit 2
else
  printf '\n========================================\n'
  printf '  Error en instalacion\n'
  printf '  Ejecuta dh doctor para diagnosticar\n'
  printf '========================================\n'
  exit 1
fi
