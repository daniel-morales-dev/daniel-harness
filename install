#!/usr/bin/env bash
# Entry point: instala y configura el harness desde cero
set -euo pipefail

ROOT_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
PROFILE=core
CONNECT=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile) PROFILE=$2; shift 2 ;;
    --profile=*) PROFILE=${1#*=}; shift ;;
    --connect) CONNECT=true; shift ;;
    --help|-h)
      printf 'Uso: ./install [--profile core|alegra|migration|full] [--connect]\n'
      printf '\n  --profile   Perfil a instalar (default: core)\n'
      printf '  --connect   Autenticacion interactiva, doctor y resumen\n'
      exit 0 ;;
    *) printf 'Argumento desconocido: %s\n' "$1" >&2; exit 1 ;;
  esac
done

case "$PROFILE" in
  core|alegra|migration|full) ;;
  *) printf 'Perfil invalido: %s (core|alegra|migration|full)\n' "$PROFILE" >&2; exit 1 ;;
esac

printf '==> Daniel Harness — instalacion perfil: %s\n' "$PROFILE"

# Validacion minima de plataforma
if [[ ! -f /etc/os-release ]] || ! grep -qi 'ubuntu' /etc/os-release 2>/dev/null; then
  printf '  [aviso] Sistema no verificado como Ubuntu\n'
fi
if ! command -v sudo >/dev/null 2>&1; then
  printf 'error: sudo es necesario\n' >&2
  exit 1
fi

# Bootstrap
printf '\n==> Ejecutando bootstrap --profile %s...\n' "$PROFILE"
bash "$ROOT_DIR/scripts/bootstrap.sh" --profile "$PROFILE"

# Connect: auth interactivo + doctor + resumen
if [[ $CONNECT == true ]]; then
  printf '\n==> Autenticacion interactiva...\n'

  MANIFEST="$ROOT_DIR/bootstrap/manifest.yaml"
  AUTH_OK=0
  AUTH_PENDING=0
  AUTH_SKIP=0

  # Extraer MCPs del perfil desde el manifest
  while IFS= read -r mcp_name; do
    [[ -z "$mcp_name" ]] && continue

    oauth_req=$(awk -v n="$mcp_name" '
      /^mcp_servers:/{in_mcp=1; next}
      in_mcp {
        if ($0 ~ "^  " n ":" && !found) { found=1; next }
        if (found && $0 ~ "^    oauth_required:") {
          gsub(/^[[:space:]]*oauth_required:[[:space:]]*/, "")
          gsub(/^["\x27]/, ""); gsub(/["\x27]$/, "")
          print; exit
        }
        if (found && $0 ~ /^  [a-z]/) { found=0 }
      }
    ' "$MANIFEST")

    if [[ "$oauth_req" != "true" ]]; then
      printf '  [- ] MCP %s: no requiere OAuth\n' "$mcp_name"
      AUTH_SKIP=$((AUTH_SKIP + 1))
      continue
    fi

    if ! command -v opencode >/dev/null 2>&1; then
      printf '  [aviso] opencode no instalado, salteando auth MCP %s\n' "$mcp_name"
      AUTH_PENDING=$((AUTH_PENDING + 1))
      continue
    fi

    printf '  [..] Autenticando MCP %s...\n' "$mcp_name"
    if opencode mcp auth "$mcp_name" >/dev/null 2>&1; then
      printf '  [ok] MCP %s autenticado\n' "$mcp_name"
      AUTH_OK=$((AUTH_OK + 1))
    else
      printf '  [aviso] MCP %s: autenticacion pendiente (ejecuta: opencode mcp auth %s)\n' "$mcp_name" "$mcp_name"
      AUTH_PENDING=$((AUTH_PENDING + 1))
    fi
  done < <(awk -v p="$PROFILE" '
    $0 ~ "^profiles:" { in_profiles=1; next }
    in_profiles && $0 ~ "^  " p ":" { in_profile=1; next }
    in_profile && $0 ~ "^    mcps:" {
      sub(/^[[:space:]]*mcps:[[:space:]]*/, "")
      gsub(/^\[|\]$/, "")
      gsub(/["\x27]/, "")
      gsub(/,/, "\n")
      print
      exit
    }
  ' "$MANIFEST")

  # Verificar GitHub PAT sin imprimirlo
  if [[ -n "${GITHUB_PERSONAL_ACCESS_TOKEN:-}" ]]; then
    printf '  [ok] GITHUB_PERSONAL_ACCESS_TOKEN configurado\n'
  else
    printf '  [aviso] GITHUB_PERSONAL_ACCESS_TOKEN no configurado (requerido para MCP GitHub)\n'
  fi

  # Doctor despues de auth
  printf '\n==> Verificando instalacion...\n'
  if bash "$ROOT_DIR/scripts/doctor.sh" --profile "$PROFILE" --strict; then
    printf '\n========================================\n'
    printf '  Harness instalado y saludable\n'
    printf '  Perfil: %s\n' "$PROFILE"
    printf '  MCPs: %d autenticados, %d pendientes, %d sin OAuth\n' "$AUTH_OK" "$AUTH_PENDING" "$AUTH_SKIP"
    printf '========================================\n'
  else
    printf '\n========================================\n'
    printf '  Harness instalado con acciones pendientes\n'
    printf '  MCPs: %d autenticados, %d pendientes, %d sin OAuth\n' "$AUTH_OK" "$AUTH_PENDING" "$AUTH_SKIP"
    printf '========================================\n'
    if (( AUTH_PENDING > 0 )); then
      printf '\nAutentica los MCPs pendientes manualmente:\n'
      printf '  opencode mcp auth <nombre>\n'
    fi
    printf '\nRevisa: dh doctor\n'
  fi
fi
