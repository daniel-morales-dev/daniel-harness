#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
HARNESS_DIR=${DANIEL_HARNESS_CONFIG_DIR:-$HOME/.config/daniel-harness}
OC_FILE="${OPENCODE_CONFIG_FILE:-$HOME/.config/opencode/opencode.json}"

show_help() {
  printf 'Uso: dh <comando> [argumentos]\n\n'
  printf 'Comandos:\n'
  printf '  doctor           Diagnóstico del harness\n'
  printf '  root             Muestra la raíz absoluta del harness\n'
  printf '  install          Configuración local + symlinks\n'
  printf '  bootstrap        Instalación completa de herramientas (--profile core|alegra|migration|full)\n'
  printf '  mcp-status       Estado de conexión y autenticación MCP\n'
  printf '  tunnel list      Lista túneles configurados\n'
  printf '  update           Actualiza el harness (tags o main)\n'
printf '  version          Muestra la versión actual del harness\n'
  printf '  project init     Asistente para nuevo proyecto\n'
printf '  session scaffold <issue>  Crea plantilla de brief\n'
printf '  session read <issue>      Plantilla + agente lee Linear via MCP\n'
printf '  session close <issue>     Cierra sesion: resumen para Engram + Linear\n'
  printf '  engram-service   Instala/systemd user service para Engram\n'
  printf '  preflight        Contexto completo del proyecto (JSON)\n'
  printf '  verify           Valida el proyecto según su contexto\n'
  printf '  context          Detecta el contexto del proyecto actual\n'
  printf '  help             Esta ayuda\n'
}

mcp_status() {
  printf '=== MCP Status ===\n'

  if ! command -v opencode >/dev/null 2>&1; then
    printf '[aviso] OpenCode no encontrado\n'
    return
  fi

  printf '\nConexión:\n'
  opencode mcp list 2>/dev/null || printf '[aviso] No se pudo listar MCPs\n'

  printf '\nAutenticación OAuth:\n'
  if opencode mcp auth list 2>/dev/null; then
    :
  else
    printf '[aviso] No se pudo verificar autenticación (puede que ningún MCP requiera OAuth)\n'
  fi

  if [[ -f "$OC_FILE" ]]; then
    local total remote local_count
    local mcp_root=""
    if jq -e '.mcp | type == "object"' "$OC_FILE" >/dev/null 2>&1; then
      mcp_root='.mcp'
    elif jq -e '.mcp.servers | type == "object"' "$OC_FILE" >/dev/null 2>&1; then
      mcp_root='.mcp.servers'
    fi
    if [[ -z "$mcp_root" ]]; then
      printf '\nResumen: 0 servidores\n'
    else
      total=$(jq "${mcp_root} | length" "$OC_FILE" 2>/dev/null || echo 0)
      remote=$(jq "[${mcp_root}[] | select(.type == \"remote\")] | length" "$OC_FILE" 2>/dev/null || echo 0)
      local_count=$(jq "[${mcp_root}[] | select(.type == \"local\")] | length" "$OC_FILE" 2>/dev/null || echo 0)
      printf '\nResumen: %s servidores (%s local, %s remoto)\n' "$total" "$local_count" "$remote"
    fi
  fi
}

tunnel_cmd() {
  local action=${1:-list}
  local conn_file="$HARNESS_DIR/connections.yaml"

  case "$action" in
    list)
      if [[ ! -f "$conn_file" ]]; then
        printf 'No hay archivo de conexiones en %s\n' "$conn_file"
        return
      fi
      printf 'Túneles configurados:\n'
      awk '
        /^  - id:/ {
          gsub(/^  - id:[[:space:]]*/, "")
          gsub(/^"|"$/, "")
          id=$0
        }
        /^    host:/ {
          gsub(/^    host:[[:space:]]*/, "")
          gsub(/^"|"$/, "")
          host=$0
        }
        /^    port:/ {
          gsub(/^    port:[[:space:]]*/, "")
          gsub(/^"|"$/, "")
          port=$0
        }
        /^      required:/ {
          gsub(/^      required:[[:space:]]*/, "")
          gsub(/^"|"$/, "")
          required=$0
        }
        /^      commandRef:/ {
          gsub(/^      commandRef:[[:space:]]*/, "")
          gsub(/^"|"$/, "")
          cmdref=$0
          printf "  %-20s %-21s requerido=%-5s comando=%s\n", id, host ":" port, required, cmdref
        }
      ' "$conn_file"
      ;;
    *)
      printf 'Uso: dh tunnel list\n'
      ;;
  esac
}

detect_context() {
  local project_dir=${1:-$PWD}
  local registry="$HARNESS_DIR/project-registry.yaml"

  if [[ -f "$registry" ]]; then
    local match
    match=$(awk -v dir="$project_dir" '
      /^families:/ { in_families=1; next }
      in_families && /^    projects:/ { in_proj=1; next }
      in_proj && /^      - id:/{gsub(/^      - id:[[:space:]]*/,""); gsub(/^"|"$/,""); name=$0; next}
      in_proj && /^        path:/{gsub(/^        path:[[:space:]]*/,""); gsub(/^"|"$/,""); path=$0; next}
      in_proj && /^        context:/{gsub(/^        context:[[:space:]]*/,""); gsub(/^"|"$/,""); ctx=$0; next}
      in_proj && /^        rules:/ && path != "" && name != "" {
        if (dir == path || index(dir, path "/") == 1) {
          print name "|" ctx "|" path; exit
        }
        name=""; path=""; ctx=""
      }
      in_families && /^  - / { in_proj=0 }
    /^[a-z]/ && $0 != "families:" { in_families=0; in_proj=0 }
    ' "$registry")

    if [[ -n "$match" ]]; then
      local name ctx path
      IFS='|' read -r name ctx path <<< "$match"
      printf 'proyecto=%s\ncontexto=%s\npath=%s\n' "$name" "$ctx" "$path"
      return
    fi
  fi

  if [[ -f "$project_dir/composer.json" ]]; then
    printf 'contexto=generic-php\n'
    printf 'detectado_por=composer.json\n'
  elif [[ -f "$project_dir/package.json" ]]; then
    local has_ts
    has_ts=$(jq -r '.devDependencies.typescript // ""' "$project_dir/package.json" 2>/dev/null)
    if [[ -n "$has_ts" ]]; then
      printf 'contexto=generic-typescript\n'
      printf 'detectado_por=package.json+typescript\n'
    else
      printf 'contexto=generic-node\n'
      printf 'detectado_por=package.json\n'
    fi
  elif [[ -f "$project_dir/go.mod" ]]; then
    printf 'contexto=generic-go\n'
    printf 'detectado_por=go.mod\n'
  else
    printf 'contexto=generic\n'
    printf 'detectado_por=default\n'
  fi
}

self_update() {
  printf 'Actualizando Daniel Harness...\n'
  git -C "$ROOT_DIR" fetch origin --prune --tags 2>/dev/null || {
    printf '[error] No se pudo contactar el remoto\n' >&2
    exit 1
  }

  local local_ref tag_ref target label
  local_ref=$(git -C "$ROOT_DIR" rev-parse HEAD)
  tag_ref=$(git -C "$ROOT_DIR" tag -l 'v*' --sort=-v:refname | head -1)

  if [[ -n "$tag_ref" ]]; then
    target="$tag_ref"
    label="$tag_ref"
  else
    target="origin/main"
    label="main"
  fi

  local remote_ref
  remote_ref=$(git -C "$ROOT_DIR" rev-parse "$target" 2>/dev/null || echo "")

  if [[ "$local_ref" == "$remote_ref" ]]; then
    printf '[ok] Ya estás en la última versión (%s)\n' "${label}"
    return
  fi

  printf 'Actualizando a %s...\n' "$label"
  git -C "$ROOT_DIR" pull --ff-only origin main || {
    printf '[error] Falló la actualización. Revisa conflictos locales.\n' >&2
    exit 1
  }

  if git -C "$ROOT_DIR" diff --name-only HEAD~1..HEAD 2>/dev/null | grep -q '^bootstrap/manifest.yaml'; then
    printf '[aviso] El manifest cambió. Ejecuta dh bootstrap para actualizar herramientas.\n'
  fi

  if git -C "$ROOT_DIR" diff --name-only HEAD~1..HEAD 2>/dev/null | grep -q '^scripts/install.sh'; then
    printf '[aviso] install.sh cambió. Ejecuta dh install para actualizar symlinks.\n'
  fi

  printf '[ok] Harness actualizado (%s)\n' "${label}"
}

preflight() {
  local ctx_output
  ctx_output=$(detect_context)
  local project_name ctx path
  project_name=$(echo "$ctx_output" | grep '^proyecto=' | sed 's/^proyecto=//' || true)
  ctx=$(echo "$ctx_output" | grep '^contexto=' | sed 's/^contexto=//' || true)
  path=$(echo "$ctx_output" | grep '^path=' | sed 's/^path=//' || true)

  local registry="$HARNESS_DIR/project-registry.yaml"
  local config_yaml="$HARNESS_DIR/config.yaml"
  local connections="$HARNESS_DIR/connections.yaml"

  _DH_PROJECT="$project_name" _DH_CONTEXT="$ctx" _DH_PATH="$path" \
  _DH_REGISTRY="$registry" _DH_CONFIG="$config_yaml" _DH_CONNECTIONS="$connections" \
  _DH_HARNESS_DIR="$HARNESS_DIR" _DH_OC_FILE="${OPENCODE_CONFIG_FILE:-$HOME/.config/opencode/opencode.json}" \
  python3 -c "
import json, sys, os, glob
try:
    import yaml
except ImportError:
    print(json.dumps({'error': 'pyyaml not installed'}))
    sys.exit(1)

project_raw = os.environ.get('_DH_PROJECT', '') or ''
result = {
    'project': project_raw if project_raw.strip() else None,
    'context': os.environ.get('_DH_CONTEXT', 'generic') or 'generic',
    'family': None,
    'scope': 'single-repo',
    'path': (os.environ.get('_DH_PATH', '') or '').strip() or None,
    'harnessRoot': '$ROOT_DIR',
    'readRepositories': [],
    'writeRepositories': [],
    'modelTrust': 'unknown',
    'mcpCapabilities': {},
    'tunnelStatus': {},
    'policies': [],
    'policyFiles': [],
    'issue': None,
    'relationships': [],
}

registry_path = os.environ.get('_DH_REGISTRY', '')
active_family = None
active_projects = []

if os.path.exists(registry_path):
    with open(registry_path) as f:
        data = yaml.safe_load(f)

    pname = result['project']
    if pname and data and 'families' in data:
        for fam in data['families']:
            for proj in fam.get('projects', []):
                if proj.get('id') == pname:
                    result['family'] = active_family = fam['id']
                    active_projects = fam.get('projects', [])
                    break
            if active_family:
                break

    if active_family:
        result['scope'] = 'related-repos' if len(active_projects) > 1 else 'single-repo'
        result['readRepositories'] = sorted(set(
            p['path'] for p in active_projects if p.get('path')
        ))
        write_projects = [p for p in active_projects if p.get('git', {}).get('push', 'ask') not in ('never', 'deny')]
        result['writeRepositories'] = sorted(set(
            p['path'] for p in write_projects if p.get('path')
        ))

    if data and 'relationships' in data:
        if active_family:
            result['relationships'] = [
                r for r in data['relationships']
                if r.get('from') == active_family or r.get('to') == active_family
            ]
        else:
            result['relationships'] = data['relationships']

config_path = os.environ.get('_DH_CONFIG', '')
if os.path.exists(config_path):
    with open(config_path) as f:
        cfg = yaml.safe_load(f) or {}
    result['modelTrust'] = cfg.get('trust', 'unknown')

oc_file = os.environ.get('_DH_OC_FILE', '')
if os.path.exists(oc_file):
    with open(oc_file) as f:
        try:
            oc = json.load(f)
            mcps = oc.get('mcp', {})
            for name, cfg in mcps.items():
                enabled = cfg.get('enabled', True)
                if enabled == False:
                    result['mcpCapabilities'][name] = 'disabled'
                elif cfg.get('type') == 'local' and cfg.get('command'):
                    cmd_name = cfg['command'][0] if isinstance(cfg['command'], list) else cfg['command'].split()[0]
                    result['mcpCapabilities'][name] = 'available' if any(
                        os.access(p + '/' + cmd_name, os.X_OK)
                        for p in os.environ.get('PATH', '').split(':')
                    ) else 'command-missing'
                elif cfg.get('type') == 'remote':
                    result['mcpCapabilities'][name] = 'configured'
                else:
                    result['mcpCapabilities'][name] = 'unknown'
        except (json.JSONDecodeError, Exception):
            pass

connections_path = os.environ.get('_DH_CONNECTIONS', '')
if os.path.exists(connections_path):
    with open(connections_path) as f:
        try:
            conn = yaml.safe_load(f) or {}
            for profile in conn.get('profiles', []):
                pid = profile.get('id', 'unknown')
                tunnel = profile.get('tunnel', {})
                if tunnel.get('required'):
                    result['tunnelStatus'][pid] = {
                        'required': True,
                        'host': profile.get('host', ''),
                        'port': profile.get('port', 0),
                    }
        except Exception:
            pass

policy_dir = os.environ.get('_DH_HARNESS_DIR', '') + '/policies'
if os.path.isdir(policy_dir):
    for f in sorted(os.listdir(policy_dir)):
        if f.endswith('.md'):
            result['policies'].append(f)
            result['policyFiles'].append(os.path.abspath(os.path.join(policy_dir, f)))

print(json.dumps(result, ensure_ascii=False, indent=2))
" 2>&1 || printf '[error] preflight: falló la generación de JSON\n'
}

project_init() {
  printf '=== Nuevo proyecto ===\n'
  read -r -p 'Nombre del proyecto: ' name
  read -r -p 'Ruta absoluta: ' path
  read -r -p 'Contexto (alegra-monolith/alegra-microservice/freelance/generic-*): ' context
  read -r -p 'Familia existente o nueva (Enter para crear automática): ' fam_input

  if [[ ! -d "$path" ]]; then
    printf '[error] La ruta no existe: %s\n' "$path" >&2
    exit 1
  fi

  case "$context" in
    alegra-monolith|alegra-microservice|freelance|generic-php|generic-typescript|generic-node|generic-go|generic) ;;
    *) printf '[error] Contexto inválido: %s\n' "$context" >&2; exit 1 ;;
  esac

  local registry="$HARNESS_DIR/project-registry.yaml"
  if [[ ! -f "$registry" ]]; then
    mkdir -p "$HARNESS_DIR"
    printf 'version: "1"\nfamilies: []\nrelationships: []\n' > "$registry"
    chmod 600 "$registry"
  fi

  TMP=$(mktemp)
  python3 -c "
import sys, yaml

registry_path = sys.argv[1]
tmp_path = sys.argv[2]
name = sys.argv[3]
path = sys.argv[4]
context = sys.argv[5]
fam_input = sys.argv[6]

VALID_CONTEXTS = {
    'alegra-monolith', 'alegra-microservice', 'freelance',
    'generic-php', 'generic-typescript', 'generic-node', 'generic-go', 'generic',
}

with open(registry_path) as f:
    data = yaml.safe_load(f) or {'version': '1', 'families': [], 'relationships': []}

if data.get('version') != '1':
    print('error: version must be \"1\"', file=sys.stderr)
    sys.exit(1)
if not isinstance(data.get('families'), list):
    print('error: families must be a list', file=sys.stderr)
    sys.exit(1)
if not isinstance(data.get('relationships'), list):
    print('error: relationships must be a list', file=sys.stderr)
    sys.exit(1)
if context not in VALID_CONTEXTS:
    print(f'error: contexto inválido: {context}', file=sys.stderr)
    sys.exit(1)

if fam_input:
    fam_id = fam_input
else:
    fam_id = 'alegra-bills' if context.startswith('alegra-') else context

family = next((f for f in data.get('families', []) if f.get('id') == fam_id), None)
if not family:
    family = {'id': fam_id, 'contexts': [context], 'projects': []}
    data.setdefault('families', []).append(family)
elif context not in family.get('contexts', []):
    family.setdefault('contexts', []).append(context)

for p in family['projects']:
    if p.get('id') == name:
        print(f'error: project \"{name}\" already exists', file=sys.stderr)
        sys.exit(1)

entry = {'id': name, 'path': path, 'context': context, 'rules': [],
    'git': {'askBeforeBranch': True, 'commit': 'ask', 'push': 'ask', 'deploy': 'ask'}}
# ponytail: repository omitted, not in schema
family['projects'].append(entry)

with open(tmp_path, 'w') as f:
    yaml.dump(data, f, default_flow_style=False, allow_unicode=True)
" "$registry" "$TMP" "$name" "$path" "$context" "$fam_input" || {
    printf '[error] No se pudo actualizar el registry (python3-yaml requerido)\n' >&2
    rm -f "$TMP"
    exit 1
  }
  mv "$TMP" "$registry"
  chmod 600 "$registry"
  printf '[ok] Proyecto "%s" registrado en %s\n' "$name" "$registry"
}

session_start() {
  local subcmd=${1:-help}
  local issue_id=${2:-}

  if { [[ "$subcmd" == "scaffold" || "$subcmd" == "read" ]] && [[ -z "$issue_id" ]]; } || { [[ "$subcmd" == "close" ]] && [[ -z "$issue_id" ]]; }; then
    printf 'Uso: dh session %s <issue-id>\n' "$subcmd"
    printf '  Ej: dh session %s ENG-123\n' "$subcmd"
    exit 1
  fi

  if [[ "$subcmd" == "help" || "$subcmd" == "--help" || "$subcmd" == "-h" ]]; then
    printf 'Uso: dh session <subcomando> <issue-id>\n\n'
    printf 'Subcomandos:\n'
    printf '  scaffold <issue-id>  Crea plantilla de brief (sin API)\n'
    printf '  read <issue-id>      Crea plantilla + instruye al agente a leer Linear vía MCP\n'
    printf '  close <issue-id>     Cierra sesión: guarda resumen para Engram + Linear\n'
    return
  fi

  local session_dir="$HARNESS_DIR/sessions"
  mkdir -p "$session_dir"

  if [[ "$subcmd" == "close" ]]; then
    local session_file="$session_dir/$issue_id.md"
    local summary_file="$session_dir/$issue_id-summary.md"

    if [[ ! -f "$session_file" ]]; then
      printf '[error] No hay sesión activa para %s\n' "$issue_id" >&2
      printf '  Crea una con: dh session scaffold %s\n' "$issue_id"
      exit 1
    fi

    # Generate session summary for Engram + Linear
    {
      printf '# Resumen de sesión: %s\n\n' "$issue_id"
      printf 'Completada: %s\n\n' "$(date '+%Y-%m-%d %H:%M:%S')"
      printf '## Contexto al cierre\n\n'
      detect_context
      printf '\n## Log de la sesión\n\n'
      cat "$session_file"
      printf '\n## Instrucciones para el agente\n\n'
      printf '1. Publica este resumen como comentario en Linear issue %s usando save_comment\n' "$issue_id"
      printf '2. Guarda el resumen en Engram con mem_session_summary\n'
    } > "$summary_file"

    printf '[ok] Resumen de sesión guardado: %s\n' "$summary_file"
    printf '\n  El agente debe:\n'
    printf '  1. Publicar comentario en Linear: save_comment(issueId="%s", body=contenido)\n' "$issue_id"
    printf '  2. Guardar en Engram: mem_session_summary(project="...", content=resumen)\n'
    return
  fi

  local session_file="$session_dir/$issue_id.md"

  # ponytail: no curl/token — el agente lee Linear via MCP
  {
    printf '# Sesión: %s\n\n' "$issue_id"
    printf 'Iniciada: %s\n\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    if [[ "$subcmd" == "read" ]]; then
      printf '> Esta plantilla debe ser poblada por el agente usando Linear MCP.\n'
      printf '> Usa linear_get_issue para leer título, descripción, estado, asignado,\n'
      printf '> labels, subtareas y comentarios. Luego completa las secciones abajo.\n\n'
    fi
    printf '## Tarea\n\n'
    printf 'ID: %s\n\n' "$issue_id"
    printf '## Contexto\n\n'
    detect_context
    printf '\n## Objetivo\n\n- \n'
    printf '\n## Criterios de aceptación\n\n- \n'
    printf '\n## Archivos afectados\n\n- \n'
  } > "$session_file"

  printf '[ok] Plantilla de sesión creada: %s\n' "$session_file"
}

engram_service() {
  local action=${1:-install}
  local service_dir="$HOME/.config/systemd/user"
  local service_file="$service_dir/engram.service"

  case "$action" in
    install|setup)
      mkdir -p "$service_dir"
      cat > "$service_file" <<-SERVICEEOF
[Unit]
Description=Engram memory service para agentes AI
Documentation=https://engram.sh

[Service]
ExecStart=%h/.local/bin/engram serve
Restart=on-failure
RestartSec=5
Environment=ENGRAM_PORT=7437

[Install]
WantedBy=default.target
SERVICEEOF
      printf '[ok] Servicio Engram creado: %s\n' "$service_file"
      systemctl --user daemon-reload 2>/dev/null || true
      printf 'Ejecuta los siguientes comandos para activarlo:\n'
      printf '  systemctl --user enable --now engram\n'
      printf '  systemctl --user status engram\n'
      ;;
    enable)
      systemctl --user enable --now engram 2>/dev/null || {
        printf '[error] systemctl no disponible o falló\n' >&2
        printf 'Prueba: systemctl --user enable --now engram\n'
      }
      ;;
    disable)
      systemctl --user disable --now engram 2>/dev/null || true
      ;;
    status)
      systemctl --user status engram 2>/dev/null || printf '[aviso] Servicio no instalado o systemd no disponible\n'
      ;;
    *)
      printf 'Uso: dh engram-service <install|enable|disable|status>\n'
      ;;
  esac
}

verify_cmd() {
  local ctx_info
  ctx_info=$(detect_context)
  local ctx
  ctx=$(echo "$ctx_info" | grep '^contexto=' | sed 's/^contexto=//' || true)
  local failures=0

  printf 'Contexto: %s\n\n' "$ctx"

  case "$ctx" in
    generic-php|alegra-monolith)
      local modified
      modified=$(git diff --name-only --diff-filter=AM HEAD 2>/dev/null || true)
      if [[ -z "$modified" ]]; then
        printf 'No hay archivos modificados. Nada que verificar.\n'
      else
        while IFS= read -r f; do
          if [[ "$f" == *.php ]]; then
            if command -v php >/dev/null 2>&1; then
              php -l "$f" 2>&1 | sed 's/^/  /' || failures=$((failures + 1))
            else
              printf '  [aviso] php no instalado, saltando lint de %s\n' "$f"
            fi
          fi
        done <<< "$modified"
      fi
      ;;
    alegra-microservice|generic-typescript)
      if [[ -f "node_modules/.package-lock.json" || -d "node_modules" ]]; then
        printf 'TypeScript: npx tsc --noEmit\n'
        npx tsc --noEmit 2>&1 | sed 's/^/  /' || { printf '  [error] TypeCheck falló\n'; failures=$((failures + 1)); }
        if grep -q '"test"' package.json 2>/dev/null; then
          printf '\nTests: npm test -- --coverage\n'
          npm test -- --coverage 2>&1 | sed 's/^/  /' || failures=$((failures + 1))
        fi
      else
        printf 'node_modules no encontrado. Ejecuta npm install primero.\n'
      fi
      ;;
    generic-node)
      if [[ -d "node_modules" ]] && grep -q '"test"' package.json 2>/dev/null; then
        printf 'Tests: npm test\n'
        npm test 2>&1 | sed 's/^/  /' || failures=$((failures + 1))
      else
        printf 'No hay test configurados o node_modules ausente.\n'
      fi
      ;;
    generic-go)
      if command -v go >/dev/null 2>&1; then
        printf 'go vet ./...\n'
        go vet ./... 2>&1 | sed 's/^/  /' || failures=$((failures + 1))
      else
        printf 'Go no instalado.\n'
      fi
      ;;
    freelance)
      printf 'Verificación freelance: contexto sin validación automática.\n'
      printf 'Revisa README.md del proyecto para comandos registrados.\n'
      ;;
    generic)
      printf 'Harness: ShellCheck + tests\n'
      if command -v shellcheck >/dev/null 2>&1; then
        shellcheck -e SC1091,SC2154,SC2317 bin/dh scripts/*.sh 2>&1 | sed 's/^/  /' || failures=$((failures + 1))
      fi
      bash -n bin/dh scripts/*.sh 2>&1 | sed 's/^/  /' || failures=$((failures + 1))
      if [[ -f "tests/harness.test.py" ]]; then
        printf '\nTests: python3 tests/harness.test.py\n'
        python3 tests/harness.test.py 2>&1 | sed 's/^/  /' || failures=$((failures + 1))
      fi
      ;;
    *)
      printf 'Contexto "%s" no tiene verificación registrada.\n' "$ctx"
      failures=1
      ;;
  esac

  if (( failures > 0 )); then
    printf '\n[error] %d verificación(es) fallaron\n' "$failures"
    return 1
  fi
  printf '\n[ok] Todas las verificaciones pasaron\n'
}

case "${1:-help}" in
  root) printf '%s\n' "$ROOT_DIR" ;;
  preflight) preflight ;;
  verify) verify_cmd ;;
  doctor) shift; exec "$ROOT_DIR/scripts/doctor.sh" "$@" ;;
  install) shift; exec "$ROOT_DIR/scripts/install.sh" "$@" ;;
  bootstrap) shift; exec "$ROOT_DIR/scripts/bootstrap.sh" "$@" ;;
  mcp-status) mcp_status ;;
  tunnel) shift; tunnel_cmd "$@" ;;
  context) shift; detect_context "$@" ;;
  version)
    _dh_tag=$(git -C "$ROOT_DIR" tag -l 'v*' --sort=-v:refname | head -1)
    printf '%s\n' "${_dh_tag:-0.0.0-dev}"
    ;;
  update) self_update ;;
  project) shift; project_init "$@" ;;
  session) shift; session_start "$@" ;;
  engram-service) shift; engram_service "$@" ;;
  help|--help|-h) show_help ;;
  *)
    printf 'Comando desconocido: %s\n\n' "$1" >&2
    show_help
    exit 1
    ;;
esac
