#!/usr/bin/env bash
# bin/dh-data-executor — Launcher estable para dh_data Python executor
set -euo pipefail

SCRIPT=$(readlink -f "$0")
ROOT_DIR=$(cd "$(dirname "$SCRIPT")/.." && pwd)
VENV="${DANIEL_HARNESS_RUNTIME_DIR:-$HOME/.local/share/daniel-harness/runtime-venv}"
export PYTHONPATH="${PYTHONPATH:+$PYTHONPATH:}$ROOT_DIR/scripts"

PYTHON=""
if [[ -x "$VENV/bin/python" ]]; then
  PYTHON="$VENV/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON="python3"
fi
if [[ -z "$PYTHON" ]]; then
  echo '{"error":"Runtime Python no encontrado"}'
  exit 1
fi
exec "$PYTHON" -m dh_data.executor 2>/dev/null
